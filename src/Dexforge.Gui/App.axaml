<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Dexforge.Gui.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <!-- Alola: the sun over a cool sea. -->
    <Color x:Key="SystemAccentColor">#C2410C</Color>
    <Color x:Key="SystemAccentColorDark1">#A8380A</Color>
    <Color x:Key="SystemAccentColorDark2">#8C2E08</Color>
    <Color x:Key="SystemAccentColorDark3">#702406</Color>
    <Color x:Key="SystemAccentColorLight1">#DB5A1F</Color>
    <Color x:Key="SystemAccentColorLight2">#EE7A3C</Color>
    <Color x:Key="SystemAccentColorLight3">#F7A172</Color>

    <!-- The quiet buttons: paper with a line round it, not the theme's grey, which reads as switched off. -->
    <SolidColorBrush x:Key="ButtonBackground">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver">#F1F4F4</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonBackgroundPressed">#E2E8E9</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonBorderBrush">#B9C6C8</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver">#8FA3A6</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonBorderBrushPressed">#8FA3A6</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonForeground">#14272B</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonForegroundPointerOver">#14272B</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonForegroundPressed">#14272B</SolidColorBrush>

    <SolidColorBrush x:Key="Ground">#F1F4F4</SolidColorBrush>
    <SolidColorBrush x:Key="Surface">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="Ink">#14272B</SolidColorBrush>
    <SolidColorBrush x:Key="Muted">#566B70</SolidColorBrush>
    <SolidColorBrush x:Key="Line">#D5DDDE</SolidColorBrush>
    <SolidColorBrush x:Key="Sun">#C2410C</SolidColorBrush>
    <SolidColorBrush x:Key="Fault">#9F1239</SolidColorBrush>
    <SolidColorBrush x:Key="Done">#0F6B5C</SolidColorBrush>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource Ground}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,7,0,0" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.unit">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,12,0" />
    </Style>

    <Style Selector="RadioButton">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Margin" Value="0,0,22,0" />
    </Style>

    <Style Selector="Button">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="22,11" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </Application.Styles>
</Application>
