<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Dexforge.Gui"
        x:Class="Dexforge.Gui.RibbonWindow"
        x:DataType="local:RibbonWindow"
        Title="리본 — Dexforge"
        Icon="/Assets/sun.ico"
        Width="640" Height="680" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24,20,24,18">
    <TextBlock Classes="hint" TextWrapping="Wrap" Text="고른 리본을 받을 수 있는 포켓몬 전부에 붙입니다. 배포 포켓몬은 카드가 준 것만 가지고, PKHeX 가 거절하는 포켓몬은 그 리본 없이 둡니다. 유저가 플레이로 얻을 수 있는 리본만 있고, 배포로만 받는 리본은 없습니다." />
    <ScrollViewer Grid.Row="1" Margin="0,10,0,10">
      <ItemsControl x:Name="List" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:RibbonRow">
            <CheckBox IsChecked="{Binding Checked}" Margin="0,2">
              <Grid ColumnDefinitions="48,*" ColumnSpacing="8">
                <Image Source="{Binding Picture}" Width="40" Height="40" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Ribbon.Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Ribbon.Title}" Classes="hint" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding Note}" Classes="hint" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </Grid>
            </CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
      <TextBlock x:Name="Note" Classes="hint" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="비우기" Margin="0,0,8,0" Click="Clear" />
      <Button Grid.Column="2" Classes="primary accent" Content="담기" IsDefault="True" Click="Done" />
    </Grid>
  </Grid>
</Window>
