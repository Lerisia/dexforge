<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AlolaDexMaker.Gui"
        x:Class="AlolaDexMaker.Gui.MainWindow"
        Title="Alola Dex Maker"
        Icon="/Assets/sun.ico"
        Width="640" Height="760" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto">

    <Grid Grid.Row="0" Margin="32,22,32,14" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Classes="title" Text="Alola Dex Maker" />
        <TextBlock Classes="hint" FontSize="13" Text="울트라썬 전국도감 세이브 만들기 · 807종 · 한국 본체, 한국어, 여자 주인공" />
      </StackPanel>
      <Button Grid.Column="1" x:Name="HelpButton" VerticalAlignment="Top" Content="도움말" Click="Help" />
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="32,2,32,18" Spacing="13">

        <Grid ColumnDefinitions="112,*">
          <TextBlock Classes="label" Text="어버이 이름" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="NameBox" Width="150" MaxLength="6" Text="미월" Watermark="미월" />
            <TextBlock Classes="hint" VerticalAlignment="Center" Text="6글자까지" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="112,*">
          <TextBlock Classes="label" Text="외국어 게임" />
          <StackPanel Grid.Column="1" Spacing="6">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" >
              <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="영어" />
              <TextBox Grid.Column="1" x:Name="EnglishBox" Width="96" MaxLength="7" Text="Selene" Watermark="Selene" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="18,0,8,0" Text="일본어" />
              <TextBox Grid.Column="3" x:Name="JapaneseBox" Width="84" MaxLength="5" Text="ミヅキ" Watermark="ミヅキ" />
              <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="18,0,8,0" Text="중국어" />
              <TextBox Grid.Column="5" x:Name="ChineseBox" Width="84" MaxLength="6" Text="美月" Watermark="美月" />
            </Grid>
            <TextBlock Classes="hint" Text="외국어판 게임에서 온 포켓몬의 어버이 이름입니다. 영어는 프랑스어·독일어·이탈리아어·스페인어판에도 씁니다." />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="112,*">
          <TextBlock Classes="label" Text="ID" />
          <StackPanel Grid.Column="1" Spacing="6">
            <StackPanel Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="SID" />
              <TextBox x:Name="SidBox" Width="76" MaxLength="4" Watermark="무작위" />
              <TextBlock VerticalAlignment="Center" Margin="22,0,8,0" Text="TID" />
              <TextBox x:Name="TidBox" Width="96" MaxLength="6" Watermark="무작위" />
            </StackPanel>
            <TextBlock x:Name="IdHint" Classes="hint" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="112,*">
          <TextBlock Classes="label" Text="볼" />
          <StackPanel Grid.Column="1" Spacing="2">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="OneBall" GroupName="ball" IsChecked="True" Content="한 가지 볼로" Margin="0,0,12,0" />
              <ComboBox x:Name="BallBox" MinWidth="150" MaxDropDownHeight="320" />
            </StackPanel>
            <RadioButton x:Name="PickedBalls" GroupName="ball" Content="볼맞춤" />
            <TextBlock x:Name="BallHint" Classes="hint" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="112,*">
          <TextBlock Classes="label" Text="색" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <RadioButton x:Name="Plain" GroupName="colour" Content="일반" />
            <RadioButton x:Name="Shiny" GroupName="colour" IsChecked="True" Content="이로치" />
            <TextBlock x:Name="ColourHint" Classes="hint" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="112,*">
          <TextBlock Classes="label" Text="개체값" />
          <StackPanel Grid.Column="1" Spacing="2">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="IvRandom" GroupName="ivs" IsChecked="True" Content="랜덤" />
              <RadioButton x:Name="IvFive" GroupName="ivs" Content="5V" />
            </StackPanel>
            <TextBlock x:Name="IvHint" Classes="hint" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="112,*">
          <TextBlock Classes="label" Text="성별" />
          <StackPanel Grid.Column="1" Spacing="2">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="SexMale" GroupName="sex" Content="수컷" />
              <RadioButton x:Name="SexFemale" GroupName="sex" Content="암컷" />
              <RadioButton x:Name="SexRandom" GroupName="sex" IsChecked="True" Content="랜덤" />
            </StackPanel>
            <TextBlock x:Name="SexHint" Classes="hint" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="112,*">
          <TextBlock Classes="label" Text="레벨" />
          <StackPanel Grid.Column="1" Spacing="2">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="LevelLowest" GroupName="level" IsChecked="True" Content="가능한 최저" />
              <RadioButton x:Name="LevelHundred" GroupName="level" Content="100" />
            </StackPanel>
            <TextBlock x:Name="LevelHint" Classes="hint" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="112,*">
          <TextBlock Classes="label" Text="얻은 기간" />
          <StackPanel Grid.Column="1" Spacing="8">
            <StackPanel Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Width="64" Text="첫날" />
              <local:DayBox x:Name="FromBox" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Width="64" Text="마지막 날" />
              <local:DayBox x:Name="ToBox" />
            </StackPanel>
            <TextBlock Classes="hint" Text="얻은 날이 이 안에서 무작위로 정해집니다. 첫날과 마지막 날을 같게 하면 하루로 통일됩니다." />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="112,*">
          <TextBlock Classes="label" Text="저장할 곳" />
          <StackPanel Grid.Column="1" Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="WhereBox" IsReadOnly="True" />
              <Button Grid.Column="1" x:Name="ChooseButton" Margin="8,0,0,0" Content="바꾸기…" Click="Choose" />
            </Grid>
            <TextBlock Classes="hint" Text="이 안에 'AlolaDexMaker-이름-TID' 폴더를 만들어 세이브(main)와 기록을 씁니다." />
          </StackPanel>
        </Grid>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="32,18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="7" Margin="0,0,24,0" VerticalAlignment="Center">
          <TextBlock x:Name="Status" TextWrapping="Wrap" />
          <ProgressBar x:Name="Bar" IsVisible="False" Minimum="0" Maximum="1" Height="6" MinWidth="0" />
          <SelectableTextBlock x:Name="Detail" Classes="hint" IsVisible="False" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}" />
          <Button x:Name="OpenButton" IsVisible="False" Content="폴더 열기" Click="Open" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="MakeButton" Classes="primary accent" VerticalAlignment="Top" IsDefault="True" Content="세이브 만들기" Click="Make" />
      </Grid>
    </Border>
  </Grid>
</Window>
