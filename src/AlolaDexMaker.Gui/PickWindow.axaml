<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AlolaDexMaker.Gui"
        x:Class="AlolaDexMaker.Gui.PickWindow"
        x:DataType="local:PickWindow"
        Title="나만의 배포박스 — Alola Dex Maker"
        Icon="/Assets/sun.ico"
        Width="620" Height="640" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24,20,24,18">
    <StackPanel Spacing="8">
      <TextBlock Classes="hint" TextWrapping="Wrap" Text="규칙으로 박스에 들어가지 않는 것들입니다. 남는 칸만큼 골라 담을 수 있습니다." />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="SearchBox" Watermark="포켓몬 · 어버이 · 지역 · 세대로 찾기" />
        <TextBlock Grid.Column="1" x:Name="Count" Classes="hint" VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
    </StackPanel>
    <ListBox Grid.Row="1" x:Name="List" Margin="0,10,0,10" SelectionMode="Multiple,Toggle" ItemsSource="{Binding Shown}" SelectedItems="{Binding Chosen}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="local:PickRow">
          <TextBlock Text="{Binding Label}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
      <TextBlock x:Name="Note" Classes="hint" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="비우기" Margin="0,0,8,0" Click="Clear" />
      <Button Grid.Column="2" Classes="primary accent" Content="담기" IsDefault="True" Click="Done" />
    </Grid>
  </Grid>
</Window>
